    {
      "id": "repair-stable-unique-sorted",
      "family": "code_repair",
      "prompt": "Repair solution.stable_unique(values): return a new list of unique integers while preserving their first occurrence order. Do not change the input list. Read and run tests_public.py; preserve that test file.",
      "files": [
        {
          "path": "solution.py",
          "content": "def stable_unique(values):\n    return sorted(set(values))\n"
        },
        {
          "path": "tests_public.py",
          "content": "from solution import stable_unique\nvalues = [3, 1, 3, 2]\nassert stable_unique(values) == [3, 1, 2]\nassert values == [3, 1, 3, 2], 'input mutated'\nprint('public checks passed')\n"
        }
      ],
      "demo_outputs": [
        {
          "path": "solution.py",
          "content": "def stable_unique(values):\n    return list(dict.fromkeys(values))\n"
        }
      ],
      "checks": [
        {
          "id": "public_tests",
          "kind": "command",
          "cmd": "\"{python}\" tests_public.py",
          "timeout_seconds": 15
        }
      ],
      "rubric": [
        {
          "id": "behavior",
          "kind": "python_cases",
          "path": "solution.py",
          "function": "stable_unique",
          "cases": [
            {
              "args": [
                [
                  3,
                  1,
                  3,
                  2
                ]
              ],
              "expected": [
                3,
                1,
                2
              ]
            },
            {
              "args": [
                []
              ],
              "expected": []
            },
            {
              "args": [
                [
                  0,
                  -1,
                  0,
                  5,
                  -1
                ]
              ],
              "expected": [
                0,
                -1,
                5
              ]
            }
          ]
        },
        {
          "id": "public_preserved",
          "kind": "file_equals",
          "path": "tests_public.py",
          "expected": "from solution import stable_unique\nvalues = [3, 1, 3, 2]\nassert stable_unique(values) == [3, 1, 2]\nassert values == [3, 1, 3, 2], 'input mutated'\nprint('public checks passed')\n"
        }
      ],
      "candidate_id": "sorted"
    },
